# --- SPORTS TRACKER CONFIG ---
#How to get the session key on Windows (Chrome)
# 1. Open Chrome and log in to sports-tracker.com.
# 2. Once you are on your dashboard, press F12 (or right-click > Inspect).
# 3. Go to the Application tab at the top (you might need to click the >> arrows if it's hidden).
# 4. In the left sidebar, expand Cookies and click on https://sports-tracker.com.
# 5. Find the row named sessionkey.
# 6. Double-click the value in the Value column and copy it. It is a 32-character alphanumeric string.
ST_SESSION_TOKEN = "{{custom_onyx_st_session_token}}"
DOWNLOAD_DIR = "/smartserver/data/home/root/gpx-export"

# --- STRAVA OAUTH2 CONFIG ---
# See documentation for details on how to get these values: https://developers.strava.com/docs/authentication/
# See sport_tokens.py for how to use these values to get the access token and refresh token
# URL to get Strava token: https://www.strava.com/oauth/authorize?client_id=XXX&response_type=code&redirect_uri=http://localhost&approval_prompt=force&scope=read,activity:read_all,activity:write
# Get code from callback url: http://localhost/?state=&code=YYY&scope=read,activity:write,activity:read_all
# POST to https://www.strava.com/oauth/token with: client_id, client_secret, code, grant_type=authorization_code to get the refresh token and access token
STRAVA_CLIENT_ID = "{{custom_onyx_strava_client_id}}"
STRAVA_CLIENT_SECRET = "{{custom_onyx_strava_client_secret}}"
STRAVA_REFRESH_TOKEN = "{{custom_onyx_strava_refresh_token}}"

# --- FITTRACKEE CONFIG ---
# Similar process like for Strava (Fittrackee ID and secret are displayed onece when create an app in Fittrackee):
# See sport_tokens.py for how to use these values to get the access token and refresh token
FIT_URL = "https://fittrackee.{{server_domain}}/"
FIT_ID = "{{custom_onyx_fit_id}}"
FIT_SECRET = "{{custom_onyx_fit_secret}}"
FIT_TOKEN = "{{custom_onyx_fit_token}}"

# --- Email and logging ---
SMTP_HOST = "{{mailserver_host}}"
SMTP_PORT = {{mailserver_port}}
SMTP_USER = "{{mailserver_username}}"
SMTP_PASSWORD = "{{mailserver_password}}"
ALERT_EMAIL = "{{root_email}}"
LOG_FILE={{global_log}}onyx/sport_sync.log